{
  "name": "guidebook",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "sharp"
  ],
  "scripts": {
    "dev": "astro dev",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:all": "bun run test && bun run test:e2e",
    "quality": "bun run lint && bun run format:check && bun run check && bun run check:tsgo",
    "verify": "bun run quality && bun run test && bun run build && bun run test:e2e",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "icons": "bun scripts/generate-icons.mjs && bun scripts/generate-og-card.mjs",
    "check": "astro check",
    "check:tsgo": "tsgo --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint --fix . --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/ts-plugin": "1.10.12",
    "@playwright/test": "^1.63.0",
    "@types/bun": "1.4.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^5.0.2",
    "lefthook": "2.1.14",
    "oxlint": "1.83.0",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.3.3",
    "astro-expressive-code": "0.44.2",
    "hast-util-from-html": "2.0.3",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3"
  }
}
