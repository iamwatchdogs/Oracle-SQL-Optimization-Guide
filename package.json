{
  "name": "guidebook",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "sharp"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "bun run check && bun run check:tsgo && astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check",
    "check:tsgo": "tsgo --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint --fix . --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/ts-plugin": "1.10.12",
    "@types/bun": "1.4.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "lefthook": "2.1.14",
    "oxlint": "1.83.0",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.3",
    "astro-expressive-code": "0.44.2",
    "astro-mermaid": "2.1.0",
    "mermaid": "12.0.0",
    "rehype-mathjax": "7.1.0",
    "remark-math": "6.0.0",
    "sharp": "0.35.4"
  }
}
