---
/*
 * One line of stand-in text.
 *
 * The outer box is the line box (`1lh` in whatever the surrounding type context
 * declares) and the bar inside it is 55% of that, centred. The split is the whole
 * point and it was found by looking at it.
 *
 * A bar the full height of its line box is exactly the height of the text it
 * stands in for, which sounds like fidelity and is not: at the home page's
 * 76.8px display type, three such bars are a single 650px × 242px grey slab with a
 * staircase cut out of it, and a reader reads that as a broken image rather than
 * as a title arriving. The 55% bar reads as three lines of very large text, and
 * the line box around it is what keeps the rows below — the abstract, the call to
 * action, the metadata margin — landing exactly where the real ones land.
 *
 * Centring rather than a top offset, because the ratio between a bar and the
 * whitespace around it is a different number in every type context in this
 * project: 1.05 leading on the display title, 1.2 on the article title, 1.65 on
 * body copy. `items-center` is the one rule that is right in all three.
 *
 * Both dimensions are set inline, and that is not a style preference.
 *
 * A Tailwind class is only emitted if its full name appears literally in a source
 * file, because the stylesheet is generated by scanning for class names. A class
 * built from a prop — `h-[${ratio}lh]` — never appears literally, so Tailwind
 * emits nothing for it, and the bar renders with no height at all. The first
 * version of this component did exactly that: the home page's display title came
 * out as 650px of empty space, which is what a missing height looks like when the
 * width is right. A length in `style` is the one form that is always emitted.
 *
 * `width` is a CSS width and `ratio` is a share of the line box: `100%`, `80%`,
 * `18rem`, `22ch`.
 */

import { SKELETON_BAR as bar } from '../lib/route-skeleton.mjs';

interface Props {
  /** Any CSS width: `100%`, `80%`, `18rem`, `22ch`. */
  width?: string;
  /** The bar's share of the line box. */
  ratio?: number;
}

const { width = '100%', ratio = 0.55 } = Astro.props;
---

<span class="flex h-[1lh] items-center">
  <span class={bar} style={`width: ${width}; height: ${ratio}lh`}></span>
</span>
