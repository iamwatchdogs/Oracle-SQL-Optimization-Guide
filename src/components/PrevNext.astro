---
interface Link {
  href: string;
  title: string;
}

interface Props {
  prev?: Link | undefined;
  next?: Link | undefined;
}

const { prev, next } = Astro.props;
const pagerLinkClass =
  'group flex min-w-0 flex-col gap-[0.35rem] rounded-ui border border-rule p-5 text-ink no-underline transition-colors hover:border-accent hover:bg-accent-soft hover:text-ink';

const pagerTitleClass =
  'font-serif text-pager font-semibold leading-[1.35] tracking-[-0.01em] transition-colors group-hover:text-accent';
---

<nav aria-label="Book navigation" class="mt-10 grid gap-3 border-t border-rule pt-8 sm:grid-cols-2">
  {prev ? (
    <a href={prev.href} rel="prev" class={pagerLinkClass}>
      <span class="running-head">← Previous</span>
      <span class={pagerTitleClass}>{prev.title}</span>
    </a>
  ) : (
    <span aria-hidden="true"></span>
  )}
  {next ? (
    <a
      href={next.href}
      rel="next"
      class={`${pagerLinkClass} sm:items-end sm:justify-end sm:text-right`}
    >
      <span class="running-head">Next →</span>
      <span class={pagerTitleClass}>{next.title}</span>
    </a>
  ) : (
    <span aria-hidden="true"></span>
  )}
</nav>
