---
/**
 * Sticky section TOC with scroll-spy (desktop) and collapsible disclosure (mobile).
 * Cue states: active heading is deep-linkable via hash.
 */
interface Heading {
  id: string;
  text: string;
  depth: number;
}

interface Props {
  headings: Heading[];
  /** Label shown above the list. */
  label?: string;
}

const { headings, label = 'On this page' } = Astro.props;
const mobileLandmarkLabel = `${label} list`;
const tocLinkClass =
  'group flex min-h-11 items-baseline gap-3 rounded-r-ui border-l border-transparent px-3 py-[0.4rem] font-sans text-ui leading-[1.4] text-ink-muted no-underline transition-colors hover:bg-accent-soft hover:text-ink data-[active=true]:border-accent data-[active=true]:bg-accent-soft data-[active=true]:font-medium data-[active=true]:text-accent';
const tocNumClass =
  'w-6 font-mono text-chip tabular-nums text-ink-faint group-data-[active=true]:text-accent';
---

{/* Desktop: sticky aside */}
<aside
  class="toc-viewport hidden lg:block sticky top-16 self-start overflow-y-auto"
  aria-label={label}
>
  <p class="running-head mb-3 pl-3">{label}</p>
  <nav id="toc-desktop" class="flex flex-col gap-0.5">
    {headings.map((h, i) => (
      <a
        href={`#${h.id}`}
        class:list={[tocLinkClass, { 'pl-toc-indent': h.depth > 2 }]}
        data-toc-link={h.id}
        data-active="false"
        title={h.text}
        aria-label={h.text}
      >
        <span class={tocNumClass}>{String(i + 1).padStart(2, '0')}</span>
        <span class="truncate">{h.text}</span>
      </a>
    ))}
  </nav>
</aside>

{/* Mobile: disclosure */}
<details class="group mb-6 border-y border-rule lg:hidden" data-toc-mobile>
  <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 py-3 font-sans text-ui font-medium text-ink-muted transition-colors group-open:text-ink [&::-webkit-details-marker]:hidden marker:content-none">
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class="disclosure-icon shrink-0 text-ink-faint transition-transform duration-[280ms] ease-[cubic-bezier(.22,1,.36,1)] group-open:rotate-45 motion-reduce:transition-none"
    >
      <path d="M12 5v14M5 12h14"></path>
    </svg>
    <span>{label}</span>
    <span class="meta ml-auto" data-toc-mobile-current></span>
  </summary>
  <div class="disclosure-flow">
    <div class="disclosure-content-inner disclosure-flow-inner">
      <nav
        class="toc-mobile-viewport flex flex-col gap-0.5 overflow-y-auto overscroll-contain py-2"
        aria-label={mobileLandmarkLabel}
      >
        {headings.map((h, i) => (
          <a
            href={`#${h.id}`}
            class:list={[tocLinkClass, { 'pl-toc-indent': h.depth > 2 }]}
            data-toc-link={h.id}
            data-active="false"
            title={h.text}
            aria-label={h.text}
          >
            <span class={tocNumClass}>{String(i + 1).padStart(2, '0')}</span>
            <span>{h.text}</span>
          </a>
        ))}
      </nav>
    </div>
  </div>
</details>

<script>
  import { createReadingTocController } from '../lib/reading-toc-controller.mjs';

  if (!Object.prototype.hasOwnProperty.call(document, 'readingTocInitialized')) {
    createReadingTocController({ document, window });
    Object.defineProperty(document, 'readingTocInitialized', { value: true });
  }
</script>
