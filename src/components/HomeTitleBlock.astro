---
/**
 * Home title block — FIRST VIEWPORT.
 * Full-bleed paper title-block: display title, abstract, 9 numbered
 * contributions, solid "Begin at Preface", mono tabular metadata
 * with zone-ramp grade chips (A1–D).
 */
interface Contribution {
  href: string;
  title: string;
  description?: string | undefined;
}

type Zone = 'a' | 'b' | 'c' | 'd';

interface GradeItem {
  label: string;
  zone: Zone;
  meaning: string;
}

interface Props {
  title: string;
  description: string;
  contributions: Contribution[];
  meta: string[];
  gradeZones?: Zone[];
  gradeLabels?: string[];
}

const gradeMeanings: Record<string, string> = {
  A1: 'Oracle versioned documentation',
  A2: 'Oracle brief or whitepaper',
  B1: 'Peer-reviewed research paper',
  B2: 'Independent reproduction',
  C1: 'Deterministic tool with repeatable output',
  C2: 'Maintained open-source project',
  D: 'Blog or forum — context only, never proof alone',
};

const { title, description, contributions, meta, gradeZones, gradeLabels } = Astro.props;
const gradeItems: GradeItem[] = (gradeLabels ?? []).flatMap((label, index) => {
  const zone = gradeZones?.[index];
  const meaning = gradeMeanings[label];
  return zone && meaning ? [{ label, zone, meaning }] : [];
});
const showGrades = gradeItems.length > 0;
---

<section class="title-block" aria-labelledby="book-title">
  <div class="shell">
    <div class="grid lg:grid-cols-[1fr_auto] gap-8 lg:gap-16 items-start">
      <div class="min-w-0">
        <h1
          id="book-title"
          class="rise rise-1 font-[family-name:var(--font-serif)] font-bold leading-[1.05] tracking-[-0.03em] mb-5"
          style="font-size: var(--text-display);"
        >
          {title}
        </h1>

        <p
          class="rise rise-2 font-[family-name:var(--font-sans)] text-[color:var(--ink-muted)] leading-relaxed max-w-[42ch] mb-8"
          style="font-size: clamp(1.05rem, 1.5vw, 1.25rem);"
        >
          {description}
        </p>

        <div class="rise rise-3">
          <a href="/00-preface/" class="btn-primary">
            Begin at Preface
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <aside
        class="rise rise-4 lg:text-right lg:border-l lg:border-[color:var(--rule)] lg:pl-8 pt-2 lg:pt-0"
        aria-label="Metadata"
      >
        <dl class="meta space-y-2">
          {meta.map((line) => (
            <div class="lg:text-right">
              <dt class="sr-only">Metadata</dt>
              <dd>
                {line === 'grades' && showGrades ? (
                  <span
                    class="inline-flex flex-wrap gap-1 justify-end"
                    aria-label="Evidence grades"
                  >
                    {gradeItems.map((grade) => (
                      <span class="grade-chip" data-zone={grade.zone}>
                        {grade.label}
                      </span>
                    ))}
                  </span>
                ) : (
                  line
                )}
              </dd>
            </div>
          ))}
        </dl>

        {showGrades && (
          <details id="evidence-key" class="evidence-key">
            <summary>
              <span class="evidence-key-title">Evidence key</span>
              <span class="evidence-key-note">Source strength, not a benchmark</span>
              <svg
                class="evidence-key-caret"
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M9 18l6-6-6-6"></path>
              </svg>
            </summary>
            <dl class="evidence-key-list">
              {gradeItems.map((grade) => (
                <div class="evidence-key-row">
                  <dt>
                    <span class="grade-chip" data-zone={grade.zone}>
                      {grade.label}
                    </span>
                  </dt>
                  <dd>{grade.meaning}</dd>
                </div>
              ))}
            </dl>
            <p class="evidence-key-rule">
              <strong>PROVEN</strong> = 2 agreeing sources, or 1 A1/A2/B1 source + a repeatable
              rerun.
            </p>
            <p class="evidence-key-links">
              <a href="/00-preface/">How grades work</a>
              <span aria-hidden="true">·</span>
              <a href="/07-appendix-sources/">Source lookup</a>
            </p>
          </details>
        )}
      </aside>
    </div>
  </div>
</section>

<script>
  const evidenceKey = document.querySelector<HTMLDetailsElement>('#evidence-key');
  if (window.location.hash === '#evidence-key' && evidenceKey) {
    evidenceKey.open = true;
  }
</script>

<section class="shell mt-0 pb-16" aria-labelledby="contributions-heading">
  <div class="max-w-[52rem]">
    <div class="pt-10 pb-4 border-b border-[color:var(--rule-strong)]">
      <h2 id="contributions-heading" class="running-head !text-[color:var(--ink-muted)] !text-xs">
        Contents · nine sections
      </h2>
    </div>

    <ol class="list-none p-0 m-0" aria-label="Book sections">
      {contributions.map((c, i) => (
        <li>
          <a href={c.href} class="contribution">
            <span class="contribution-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="min-w-0">
              <span class="contribution-title block">{c.title}</span>
              {c.description && <span class="contribution-desc block">{c.description}</span>}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>
