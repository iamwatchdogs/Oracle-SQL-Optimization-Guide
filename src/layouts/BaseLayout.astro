---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import { MEASURE_STEPS, TEXT_SCALE_STEPS } from '../lib/reading-prefs-controller.mjs';
import {
  REPO_URL,
  resolveBase,
  SITE_DESCRIPTION,
  SITE_LOCALE,
  SITE_TITLE,
  THEME_COLOR,
  withBase,
  withoutBase,
} from '../lib/site.mjs';
import '../styles/global.css';

interface SectionLink {
  href: string;
  title: string;
  description?: string | undefined;
}

interface Props {
  title: string;
  description?: string | undefined;
  /** Show the compact site header (running head + nav + toggle). */
  bare?: boolean;
  sections?: SectionLink[];
  sectionPosition?: number | undefined;
  /**
   * Emit `<meta name="robots" content="noindex">`. Use for error pages.
   *
   * An error page also omits its canonical, because there is no URL for it to be
   * canonical *to*. A 404 declares itself canonical at a path that does not exist,
   * and `<link rel="canonical">` is a hint a crawler may follow — pointing one at
   * a page that itself 404s teaches a crawler about a page that is not there.
   */
  noindex?: boolean;
}

const {
  title,
  description,
  bare = false,
  sections = [],
  sectionPosition,
  noindex = false,
} = Astro.props;
/*
 * Bare routes, like every other href in this component: this list is compared
 * against `currentPath`, which is a bare route too. The prefix is applied once,
 * where the href is rendered, so the comparison and the link cannot disagree.
 */
const fallbackSections: SectionLink[] = [
  { href: '/00-preface/', title: 'Preface' },
  { href: '/01-proven-techniques/', title: 'Proven Techniques' },
  { href: '/02-papers-behind-recipes/', title: 'Papers Behind Recipes' },
  { href: '/03-toolbox/', title: 'Toolbox' },
  { href: '/04-recipes/', title: 'Recipes' },
  { href: '/05-feedback-loop/', title: 'Feedback Loop' },
  { href: '/06-oss-guide/', title: 'OSS Guide' },
  { href: '/07-appendix-sources/', title: 'Appendix: Sources' },
  { href: '/08-bonus-batch-api/', title: 'Bonus: Batch API' },
];
const navigationSections = sections.length > 0 ? sections : fallbackSections;

/*
 * `Astro.url.pathname` carries the deployment prefix, but every href in this
 * component and in every caller is written as the bare route. Comparing the two
 * directly never matches, so the section list quietly stops marking where the
 * reader is. Both sides are reduced to the route before anything compares them.
 */
const currentPath = withoutBase(Astro.url.pathname);

/*
 * The reading-preference steppers, in the order the controls present them.
 *
 * They come from the controller's step lists rather than being written out here,
 * so the stylesheet, the controller's validation and the rendered buttons cannot
 * drift into three different sets. `aria-pressed` is what says which is live.
 */
const textScales = TEXT_SCALE_STEPS;
const measures = MEASURE_STEPS;

const fullTitle =
  title === SITE_TITLE ? `${title} — Evidence-graded tuning` : `${title} · Oracle SQL Optimization`;

/* One fallback, used by BOTH `<meta name="description">` and `og:description`.
   Astro omits an attribute whose value is `undefined`, so having the fallback
   on one line only meant a page without frontmatter `description` shipped a
   human-readable description and no social one at all. */
const metaDescription = description ?? SITE_DESCRIPTION;
/* og:locale wants language_TERRITORY; the site's BCP 47 tag is a bare 'en'. */
const ogLocale = SITE_LOCALE === 'en' ? 'en_US' : SITE_LOCALE;

/* Canonical must never carry a query string or fragment, and must resolve
   against the configured site origin rather than whatever host served the page. */
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;

/* The route, not the deployed pathname: with `base` set, the home page arrives as
   `/Oracle-…/` rather than `/`, and reading that as an article declared the front
   page an article to every social card and every crawler. */
const isArticle = currentPath !== '/';

/*
 * The three absolute URLs the head has to state outright, because a social card,
 * a structured-data block and a discovery link are all read by something other
 * than a browser resolving a relative path — and each one is a link that has to
 * be right about the prefix.
 *
 * `siteRoot` is the deployed origin including the repository path. It is built by
 * joining, not by concatenating, because a root-relative path handed to `new URL`
 * resolves against the origin and silently throws the prefix away.
 */
const origin = Astro.site ?? Astro.url.origin;
const siteRoot = new URL(`${resolveBase()}/`, origin).href;
const socialImage = new URL('og-default.png', `${siteRoot}`).href;
const sitemapHref = new URL('sitemap-index.xml', siteRoot).href;
const llmsHref = new URL('llms.txt', siteRoot).href;
const feedHref = new URL('rss.xml', siteRoot).href;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <ClientRouter fallback="animate" />
    {/*
      The icon set is real files rather than an inline data URI. A data URI
      cannot be cached across pages, cannot be a home-screen icon at 192px, and
      meant every page re-parsed the same 300 bytes of SVG. The order is the one
      browsers expect: the ICO first, because Safari and older desktop browsers
      still ask for it by name and would otherwise take the SVG and render it
      with no fallback.
    */}
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('/favicon-16x16.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />

    {/*
      The paper colour, so a browser paints its own chrome in the book's colour
      rather than in white. One constant, shared with the manifest — a custom
      property cannot be read by a `<meta>` or a JSON document at the point it is
      emitted, and three literals would be three chances to disagree.
    */}
    <meta name="theme-color" content={THEME_COLOR} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <meta name="application-name" content="Oracle SQL" />
    {/* No canonical on a noindex page — see the `noindex` prop. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_TITLE} — social card`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />

    {/*
      Machine-readable index and a statement of what the book is.

      The sitemap link is the documented discovery method, and it matters here
      more than usual: this is a project site, so robots.txt is served from a
      subdirectory where RFC 9309 says a crawler will not look. Declaring the
      sitemap in the head is the one discovery route that does not depend on a
      file being fetched from the origin root.

      `llms.txt` is declared with `rel="describedby"`, which is what the v2 spec
      asks for: the file covers every URL under its path, and this link is how a
      client finds the file that covers the page it is looking at.

      The JSON-LD describes the book rather than the page, because the book is what
      the page is an instance of, and a `WebSite` node is the one thing here that
      a search engine can attach a sitelinks search box to. `TechArticle` would
      want an author, a date and a real word count, none of which this corpus
      records, and inventing them is worse than not claiming the type.
    */}
    <link rel="sitemap" type="application/xml" href={sitemapHref} />
    <link rel="describedby" type="text/markdown" href={llmsHref} />

    {/* Autodiscovery, so a reader's feed reader finds the book without being
        told the URL. A link nothing points at is a URL nobody will visit. */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_TITLE} — chapters`}
      href={feedHref}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_TITLE,
        description: SITE_DESCRIPTION,
        url: siteRoot,
        inLanguage: SITE_LOCALE,
        publisher: {
          '@type': 'Organization',
          name: SITE_TITLE,
          url: siteRoot,
        },
      })}
    ></script>
    {/*
      Fonts — Astro Fonts API — and which of them the parser is told to fetch first.

      `preload` is not a boolean. `FontPreloadFilter` is
      `boolean | Array<{ weight?, style?, subset? }>`
      (`node_modules/astro/dist/assets/fonts/types.d.ts`), the `<Font>` component types its prop
      that way (`node_modules/astro/components/Font.astro:10`), and `filterPreloads` matches the
      array entry-by-entry (`dist/assets/fonts/core/filter-preloads.js:8-21`) — so `{ style: 'normal' }`
      names exactly one of a family's files. Written as the bare `true` it means "every file this
      family owns" (`filter-preloads.js:5-7`), and this family owns two: `styles: ['normal',
      'italic']` in `astro.config.mjs`. That is why the serif prop below is a filter and not a flag,
      and it is not a workaround — it is the documented shape of the prop, evaluated per render
      (`Font.astro:22`), so one layout gets per-style control it appears not to offer.

      WHAT EACH LINE IS FOR, measured in Chromium against this build rather than argued.

      - `--face-serif`, UPRIGHT ONLY. The `<h1>` is 50,952 bytes, is on every page, and was the
        largest-contentful-paint element on 69 of 74 page-and-viewport pairs. There is no argument
        against it.
      - `--face-sans`. Unchanged, and unchanged for the reason c7a3785 recorded: it paints every
        visible control in the running head (`Contents`, `Repo`, `Reading`, `Theme`) on all 37 pages.
      - `--face-mono`, NEW. This was the one face with no preload, and it is the face the running
        head is set in — the wordmark (`class="running-head"`, this file's header) and the
        `Section 02 / 09` counter in the nav summary — inside a `sticky top-0` header, so it is in
        the first viewport on every page. At 31,340 bytes it is also the smallest of the four.
        Chromium found it from the CSSOM rather than the parser, so `ResourceTiming.initiatorType`
        read `css` where the other three read `link`: under an emulated Slow 4G link (1.6 Mbps,
        150 ms RTT) its `responseEnd` was 1817 ms against 1365-1410 ms for the trio, so the header
        painted in `ui-monospace` and swapped about 400 ms later.

      WHY THE ITALIC FACE IS NOT ON THAT LIST, since it is the larger decision. 51,720 bytes — the
      largest file the site ships — and nothing in the first viewport uses it on 30 of the 37 content
      pages. It is not unused: all 37 render italic text, so the browser still downloads the file,
      and it is the largest-contentful-paint element on 4 of them. What the preload bought was the
      PARSER asking for it before the document existed, which is a bad trade when the file is also
      the largest one in flight and the three faces a reader is actually looking at are behind it.
      Dropping it does not remove a byte — it moves that file out of the group resolved before first
      paint and into the group resolved after layout, behind the three the reader is looking at. The
      cost is that the italic glyphs arrive later; `font-display: swap` on all 24 faces is what makes
      that a swap rather than a blank. Asserted by `test/integration/font-preload.test.mjs` and
      `test/e2e/font-preload.spec.mjs`.

      REJECTED, and why, so nobody re-runs them:

      - `preload` on all four. 182,444 bytes of font handed to the parser, on a heaviest page whose
        document is 186,369 bytes; the fonts would nearly double the cold load, for a face 30 of 37
        pages cannot see in the first screenful.
      - Leave the serif prop alone and add `preload` to the mono one. Fixes the half that is easiest
        to see and leaves the half that costs the most bytes. The italic preload would still be
        sitting in front of every reader.
      - Drop serif and let the `<h1>` fall back. The `<h1>` is the site's own title, and it is the
        largest contentful paint on both pages a reader can land on directly.

      ONE THING THAT IS NOT CLAIMED: the cost. Preloading is site-wide here because these three tags
      are unconditional, and the italic face is in the first viewport on 7 of 37 pages — so on those
      the swap lands a little later than it used to. Per-page preload would mean the layout inspecting
      its own content, which is a worse contract than the one line it replaces.
    */}
    <Font cssVariable="--face-serif" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--face-sans" preload />
    <Font cssVariable="--face-mono" preload />

    {/*
      Theme and reading preferences init — dark default; everything else from
      stored preference.

      One blocking inline script, not two. Both halves have to land before the
      first paint, and a second script would have to observe the first one's DOM
      write to build on it, which is a worse contract than one script that owns
      all of it. Every read is inside the `try`, so a storage-blocked reader gets
      the defaults rather than an exception in the head.

      `data-title-entrance` marks the FIRST document only. `.rise` is the title
      block's entrance and the router re-creates that markup on every client
      navigation, so without the marker the abstract and the metadata margin kept
      drifting into place 740ms after a cross-fade that ended at 180ms.
    */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.dataset.titleEntrance = '';
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'light') {
            root.dataset.theme = 'light';
          }
          /* dark is default; no prefers-color-scheme override */
        } catch (e) {
          /* dark default */
        }
        try {
          var text = localStorage.getItem('reading-text');
          if (text === '0.9' || text === '1.1' || text === '1.2') {
            root.dataset.readingText = text;
          }
          var measure = localStorage.getItem('reading-measure');
          if (measure === '60' || measure === '75') {
            root.dataset.readingMeasure = measure;
          }
          if (localStorage.getItem('reading-toc') === 'collapsed') {
            root.dataset.readingToc = 'collapsed';
          }
        } catch (e) {
          /* reader defaults */
        }
      })();
    </script>
  </head>
  <body>
    {/* `focus-visible:fixed` (not `absolute`) so the link stays reachable after
        the reader has scrolled, and the positioning lives on the focus variant
        only so the outcome never depends on Tailwind's utility sort order. */}
    <a
      href="#main"
      class="primary-control leading-none sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-2 focus-visible:left-2 focus-visible:z-50"
    >
      Skip to content
    </a>

    {!bare && (
      /* Two deliberate omissions from this element.
       *
       * No transition directives at all — no `transition:persist`, and none wanted.
       *
       * Persisting the header is the obvious-looking next step after a route swap:
       * it would make the chrome literally motionless across the navigation. Do not
       * do it. The `Contents` trigger carries a section counter — `Section 02 / 09`
       * on a chapter, `09 sections` on the home page — which is this design system's
       * running head, and a persisted element keeps its DOM, so the counter would
       * survive the hop and a reader sitting in Section 03 would be looking at
       * `Section 02 / 09`. There is no way to persist the shell and re-render one
       * child. The wordmark, the two dropdown triggers and the theme toggle are
       * chrome; the counter is page state, and this element holds both.
       * `test/e2e/running-head.spec.mjs` is the guard, and it exists for this reason.
       *
       * The counter cross-fading with the page it belongs to is correct, not an
       * oversight. It is a running head doing what a running head does, and it
       * cross-fades over an identical `bg-paper` ground, so the header does not dim
       * or move while it happens. Animating the header *as a group* is a different
       * and rejected thing: that made four sibling elements cross-fade independently
       * instead of one page, which is content-entrance behaviour on furniture.
       *
       * `max-[48rem]:static`. The mobile menu is in flow (see the note on the
       * `<details>` below), so an open panel makes the header as tall as the
       * section list. A sticky header that owns 905px of an 844px viewport is
       * worse than one that scrolls away, so below `48rem` the header returns to
       * normal flow and the menu is simply the next thing in the page. */
      <header class="sticky top-0 z-40 border-b border-rule bg-paper max-[48rem]:static">
        <div class="mx-auto flex min-h-12 w-shell items-center justify-between gap-3 max-[30rem]:gap-2 max-[48rem]:flex-wrap max-[48rem]:gap-y-2">
          {/*
            `min-h-11` + `flex items-center` on the wordmark itself: as a bare
            flex child it sized to its 18px line box, so the only route home in
            the header was an 18px touch target on a phone.
          */}
          <a
            href={withBase('/')}
            class="running-head flex min-h-11 shrink-0 items-center no-underline transition-colors hover:text-accent"
          >
            Oracle SQL <span class="max-[48rem]:hidden">· Notebook</span>
          </a>

          {/*
            The repository link is an `<a>`, not a `<button>`, and that is not a
            detail. It navigates rather than toggles, so the element is right —
            but it is also load-bearing: `hit-targets.test.mjs` locates the theme
            toggle with a NON-GREEDY match that starts at the first `<button` in
            this file. A fourth control written as a button would capture the
            markup between itself and `#theme-toggle` and assert the wrong string.

            Its resting treatment is the other three's, verbatim. That is the whole
            argument that a link out of the world can sit in the top bar without
            becoming the loudest thing in it: at rest there is no box, the ink is
            `--ink-muted`, and the accent arrives on approach. Nothing about the
            resting state announces it — the reader finds it by looking, the way
            they find `Contents` and `Theme`.

            `no-underline` is explicit because the wordmark needs it too and the
            header has no blanket anchor reset to inherit.

            Below `30rem` the control takes its own row, which is the only way this
            link can exist in the header at all. Measured at 390px: the four controls
            need 416px of a 358px row, and `#reading-prefs` has a 2px margin before
            its own 320px panel leaves the viewport. A 4th inline control moves that
            summary 41px left and puts the panel at x=-40 — the reading-prefs buttons
            fail `keepsHeaderInsideViewport` at -23, not the link that caused it.
            So below `30rem` this is `basis-full shrink-0` and the header is two
            rows — both halves are load-bearing. `basis-full` alone is not enough:
            `flex-shrink` defaults to 1, so the link compresses back onto the first
            row instead of claiming a line of its own, which squeezed `#reading-prefs`
            to x=147 at 480px and threw its panel to x=-173. Above the breakpoint the
            row has the room and this sits inline with the other three.

            That also makes the mobile target better rather than worse: a full-width
            44px row beats a 34px glyph wedged between three neighbours.

            `aria-label` is absent at rest and wrong to add for the same reason the
            other three carry none — the voice-control contract wants the accessible
            name to begin with the visible word. It is here because the word is
            visible at every width, so "Repo" is a prefix of nothing and needs no
            label; the name is the text. Nothing here is glyph-only.
          */}
          <a
            href={REPO_URL}
            aria-label="Repository"
            class="flex min-h-11 list-none items-center gap-[0.6rem] rounded-ui border border-transparent px-3 py-2 font-sans text-ui font-medium text-ink-muted no-underline transition-colors hover:border-control-edge hover:text-accent focus-visible:border-control-edge focus-visible:text-ink max-[30rem]:gap-0 max-[30rem]:px-[0.55rem]"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 16 16"
              fill="currentColor"
              class="shrink-0"
              aria-hidden="true"
            >
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A7.995 7.995 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
            <span class="max-[30rem]:hidden">Repo</span>
          </a>

          {/*
              Below `48rem` the menu is IN FLOW, full width, under the header
              controls — not an overlay.

              A `<details>` establishes a containing block for its non-summary
              children REGARDLESS of `position` (Chrome wraps them in
              `::details-content`, whose `content-visibility` implies
              `contain: layout paint size`). So a panel positioned `fixed` or
              `absolute` from inside one resolves `left`, `right` and `width`
              against the ~104px summary box rather than the viewport. Measured:
              the overlay was 71.78px wide at x=234 and ran 358px off a 390px
              screen. Nothing positioned from inside a `<details>` can overlay
              the viewport, so the mobile presentation stops trying.

              `max-[48rem]:open:basis-full` is what keeps the CLOSED header at
              48px: `basis-full` unconditionally would wrap the summary onto its
              own row even when the menu is shut, doubling the height of a
              sticky header that is on screen at all times.
            */}
          {navigationSections.length > 0 ? (
            <details
              id="site-nav"
              data-dropdown
              class="group relative ml-auto max-[48rem]:static max-[48rem]:open:basis-full"
            >
              {/*
              At rest this trigger is a word and a glyph, not a box. It carried a
              permanent `--control-edge` border, which put three 3.23:1 boxes in a
              header that already has a hairline under it — four horizontal lines in
              48px — and made the least important thing on the page the loudest.

              WCAG 1.4.11 asks for 3:1 on the visual information *required* to
              identify a control, and the boundary is not required when the control
              says what it is: this is the word "Contents" at 5.4:1, next to a
              section count, next to a disclosure glyph. The box comes back for
              hover, for open, and for `focus-visible`, so the affordance is never
              more than a hover away, and `border-transparent` keeps the 1px box
              model reserved so its arrival moves nothing.

              `ReadingTocToggle` already works this way, and the panel below keeps
              its own `--rule-strong` hairline when open.
            */}
              <summary class="flex min-h-11 list-none items-center gap-[0.6rem] rounded-ui border border-transparent focus-visible:border-control-edge focus-visible:text-ink px-3 py-2 font-sans text-ui font-medium text-ink-muted transition-colors hover:border-control-edge hover:text-accent group-open:border-control-edge group-open:text-ink max-[30rem]:px-[0.55rem] [&::-webkit-details-marker]:hidden marker:content-none">
                <span>Contents</span>
                {/* Decorative: the accessible name of this button must not change
                    with viewport width (WCAG 2.5.3, Label in Name). */}
                <span
                  class="font-mono text-chip whitespace-nowrap text-ink-faint max-[48rem]:hidden"
                  aria-hidden="true"
                >
                  {sectionPosition
                    ? `Section ${String(sectionPosition).padStart(2, '0')} / ${String(navigationSections.length).padStart(2, '0')}`
                    : `${String(navigationSections.length).padStart(2, '0')} sections`}
                </span>
                <svg
                  class="disclosure-icon shrink-0 text-ink-faint transition-transform duration-[280ms] ease-[cubic-bezier(.22,1,.36,1)] group-open:rotate-45 motion-reduce:transition-none"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M12 5v14M5 12h14"></path>
                </svg>
              </summary>
              {/*
                Desktop: a right-anchored dropdown capped at 22rem, hanging off
                the summary. Mobile: `static` and full width, so it joins the
                header's wrapping flow — see the note on the `<details>` above.
              */}
              <div class="absolute right-0 top-[calc(100%_+_0.5rem)] z-50 w-[min(22rem,calc(100vw_-_2rem))] max-[48rem]:static max-[48rem]:mt-2 max-[48rem]:max-h-[70vh] max-[48rem]:w-full disclosure-flow">
                <div class="disclosure-flow-inner">
                  <nav
                    class="nav-overlay-viewport w-full overflow-y-auto overscroll-contain border border-rule-strong bg-paper p-2"
                    aria-label="Book sections"
                  >
                    {navigationSections.map((section, index) => {
                      /*
                       * Both sides reduced to a bare route. `currentPath` is one
                       * already; the section href may not be, because a caller
                       * can hand over links that have been through `withBase`
                       * while the fallback list is written out bare.
                       */
                      const sectionPath = withoutBase(section.href);
                      const isActive =
                        currentPath === sectionPath || currentPath.startsWith(sectionPath);
                      return (
                        <a
                          href={withBase(section.href)}
                          class="group grid min-h-11 grid-cols-[2.25rem_minmax(0,1fr)] items-baseline gap-2 px-[0.65rem] py-[0.55rem] font-sans text-ui leading-[1.35] text-ink-muted no-underline transition-colors hover:bg-accent-soft hover:text-accent data-[active=true]:border-l data-[active=true]:border-accent data-[active=true]:bg-accent-soft data-[active=true]:text-accent"
                          aria-current={isActive ? 'location' : undefined}
                          data-active={isActive ? 'true' : 'false'}
                          data-astro-prefetch
                        >
                          <span
                            class="font-mono text-chip tabular-nums text-ink-faint group-data-[active=true]:text-accent"
                            aria-hidden="true"
                          >
                            {String(index + 1).padStart(2, '0')}
                          </span>
                          <span class="min-w-0">
                            <span class="block">{section.title}</span>
                            {section.description && (
                              /* `ink-muted`, not `ink-faint`. At 11px this is
                                 body-size text, and `ink-faint` measured 4.48:1 on
                                 the light theme's `accent-soft` hover wash — a
                                 hard fail against 4.5:1, live description copy.
                                 `ink-muted` clears it in both themes and on both
                                 the resting and hovered backgrounds. */
                              <span class="mt-0.5 block text-chip leading-[1.4] text-ink-muted">
                                {section.description}
                              </span>
                            )}
                          </span>
                        </a>
                      );
                    })}
                  </nav>
                </div>
              </div>
            </details>
          ) : null}

          {/*
            Reading preferences.

            Two steppers, not a settings page: text scale on four steps and line
            measure on three. Both write one attribute on `<html>` and nothing
            else — the ramp and the measure live in `global.css`, so the control
            is a projection of the stylesheet rather than a second copy of it.

            The measure steppers are labelled in CHARACTERS, because that is the
            unit the stylesheet is written in and the number a reader of a
            68-character book already has a feel for. The scale steppers are
            labelled with an `A` at the size they select, so the control is its
            own preview and needs no icon set to explain itself.
          */}
          {/* `data-dropdown` is the whole dismissal contract: this panel and the
              section list beside it close when the reader looks away, and the other
              two disclosures in the project — the evidence key and the mobile
              outline — deliberately do not. An evidence key is something you read
              in place, and a mobile outline that closed when a link inside it took
              focus would close on every use. */}
          <details class="group relative" id="reading-prefs" data-dropdown>
            <summary class="flex min-h-11 list-none cursor-pointer items-center gap-[0.6rem] rounded-ui border border-transparent focus-visible:border-control-edge focus-visible:text-ink px-3 py-2 font-sans text-ui font-medium text-ink-muted transition-colors hover:border-control-edge hover:text-accent group-open:border-control-edge group-open:text-ink max-[30rem]:px-[0.55rem] [&::-webkit-details-marker]:hidden marker:content-none">
              <span class="max-[30rem]:hidden">Reading</span>
              {/* `Aa` is the control's own preview, not an icon: two letters at two
                  sizes is the most legible shorthand there is for a type control,
                  and it needs no icon set to be understood. Hidden from the tree so
                  the accessible name does not change with viewport width
                  (WCAG 2.5.3, Label in Name). */}
              <span class="font-serif text-ui max-[30rem]:inline" aria-hidden="true">
                Aa
              </span>
              <svg
                class="disclosure-icon shrink-0 text-ink-faint transition-transform duration-[280ms] ease-[cubic-bezier(.22,1,.36,1)] group-open:rotate-45 motion-reduce:transition-none"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 5v14M5 12h14"></path>
              </svg>
            </summary>
            {/*
              `absolute` at EVERY width, which is the opposite of the section
              list's treatment and the reason for the difference.

              The section list cannot overlay: nine 44px rows is most of a phone
              viewport, so below `48rem` it goes in flow and the header returns to
              normal flow with it. This panel is 320px of mostly whitespace, and
              putting it in flow made the header 402.3px tall on an 844px
              viewport — the panel pushed its own summary onto a second row and
              the theme button onto a third, so opening a text-size control ate
              half the screen. A `<details>`'s panel is positioned against the
              summary's own box, and a right-anchored 20rem dropdown needs
              nothing more than that: it hangs off the control that opened it and
              covers the article, which is what a dropdown is for.
            */}
            <div class="absolute right-0 top-[calc(100%_+_0.5rem)] z-50 w-[min(20rem,calc(100vw_-_2rem))] disclosure-flow">
              <div class="disclosure-flow-inner">
                <div
                  class="nav-overlay-viewport w-full overflow-y-auto overscroll-contain border border-rule-strong bg-paper p-4"
                  aria-label="Reading preferences"
                >
                  <div class="flex flex-col gap-4">
                    <fieldset class="m-0 border-0 p-0">
                      <legend class="running-head mb-2 p-0">Text size</legend>
                      <div class="grid grid-cols-4 gap-1.5">
                        {textScales.map((scale) => (
                          <button
                            type="button"
                            class="flex min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-ui border border-control-edge bg-transparent font-serif text-ink transition-colors hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:bg-accent-soft aria-pressed:text-accent"
                            data-reading-pref="text"
                            data-value={scale}
                            aria-pressed="false"
                            aria-label={`Set text size to ${Math.round(Number(scale) * 100)}%`}
                          >
                            {/*
                              The preview is the step it selects, at 1.5× so a
                              10% step is still visibly a step: at 1.1× the four
                              letters read as four near-identical rows.
                            */}
                            <span
                              class="leading-none"
                              style={`font-size: ${Number(scale) * 1.5}rem`}
                            >
                              A
                            </span>
                          </button>
                        ))}
                      </div>
                    </fieldset>

                    <fieldset class="m-0 border-0 p-0">
                      <legend class="running-head mb-2 p-0">Line measure · characters</legend>
                      <div class="grid grid-cols-3 gap-1.5">
                        {measures.map((measure) => (
                          <button
                            type="button"
                            class="flex min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-ui border border-control-edge bg-transparent font-mono text-mono tabular-nums text-ink transition-colors hover:border-accent hover:text-accent aria-pressed:border-accent aria-pressed:bg-accent-soft aria-pressed:text-accent"
                            data-reading-pref="measure"
                            data-value={measure}
                            aria-pressed="false"
                            aria-label={`Set line measure to ${measure} characters`}
                          >
                            {measure}
                          </button>
                        ))}
                      </div>
                    </fieldset>

                    <p class="meta m-0 leading-[1.5] normal-case">
                      Saved on this device. Both restore on your next visit.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </details>

          <button
            type="button"
            id="theme-toggle"
            class="inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center gap-1.5 rounded-ui border border-transparent focus-visible:border-control-edge focus-visible:text-ink bg-transparent px-2.5 py-1.5 font-sans text-ui font-medium leading-none text-ink-muted transition-colors hover:border-control-edge hover:text-accent"
            aria-label="Switch to light theme"
          >
            <svg
              data-theme-icon="dark"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg
              data-theme-icon="light"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
            </svg>
            <span class="theme-label hidden sm:inline">Theme</span>
          </button>
        </div>
      </header>
    )}

    <slot />

    <script>
      import '../lib/client-init.mjs';
    </script>
  </body>
</html>
