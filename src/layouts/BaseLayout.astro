---
import { Font } from 'astro:assets';
import { ClientRouter, fade } from 'astro:transitions';
import '../styles/global.css';

interface SectionLink {
  href: string;
  title: string;
  description?: string | undefined;
}

interface Props {
  title: string;
  description?: string | undefined;
  /** Show the compact site header (running head + nav + toggle). */
  bare?: boolean;
  sections?: SectionLink[];
  sectionPosition?: number | undefined;
}

const { title, description, bare = false, sections = [], sectionPosition } = Astro.props;
const fallbackSections: SectionLink[] = [
  { href: '/00-preface/', title: 'Preface' },
  { href: '/01-proven-techniques/', title: 'Proven Techniques' },
  { href: '/02-papers-behind-recipes/', title: 'Papers Behind Recipes' },
  { href: '/03-toolbox/', title: 'Toolbox' },
  { href: '/04-recipes/', title: 'Recipes' },
  { href: '/05-feedback-loop/', title: 'Feedback Loop' },
  { href: '/06-oss-guide/', title: 'OSS Guide' },
  { href: '/07-appendix-sources/', title: 'Appendix: Sources' },
  { href: '/08-bonus-batch-api/', title: 'Bonus: Batch API' },
];
const navigationSections = sections.length > 0 ? sections : fallbackSections;
const currentPath = Astro.url.pathname;

const fullTitle =
  title === 'Oracle SQL Optimization for Junior Devs'
    ? `${title} — Evidence-graded tuning`
    : `${title} · Oracle SQL Optimization`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta
      name="description"
      content={
        description ??
        'Prove every speed win twice. A short book from 68 proven Oracle fixes, tools, and safe ship habits.'
      }
    />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter fallback="animate" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230c0c0e'/%3E%3Cpath d='M7 9h18M7 16h18M7 23h11' stroke='%238aa4ff' stroke-width='2'/%3E%3C/svg%3E"
    />
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />

    {/* Fonts — Astro Fonts API */}
    <Font cssVariable="--face-serif" preload />
    <Font cssVariable="--face-sans" />
    <Font cssVariable="--face-mono" />

    {/* Theme init — dark default; light only from stored preference or OS */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light') {
            document.documentElement.dataset.theme = 'light';
          }
          /* dark is default; no prefers-color-scheme override */
        } catch (e) {
          /* dark default */
        }
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="primary-control leading-none sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-2 focus:left-2"
    >
      Skip to content
    </a>

    {!bare && (
      <header
        transition:animate={fade({ duration: '0.18s' })}
        class="sticky top-0 z-40 border-b border-rule bg-paper"
      >
        <div class="mx-auto flex h-12 w-shell items-center justify-between gap-3 max-[30rem]:gap-2">
          <a
            href="/"
            class="running-head shrink-0 transition-colors hover:text-accent no-underline"
          >
            Oracle SQL <span class="max-[30rem]:hidden">· Notebook</span>
          </a>

          {navigationSections.length > 0 ? (
            <details class="group relative ml-auto">
              <summary class="flex min-h-11 cursor-pointer list-none items-center gap-[0.6rem] rounded-ui border border-rule px-3 py-2 font-sans text-ui font-medium text-ink-muted transition-colors hover:border-rule-strong hover:text-ink group-open:border-rule-strong group-open:text-ink max-[30rem]:px-[0.55rem] [&::-webkit-details-marker]:hidden marker:content-none">
                <span>Contents</span>
                <span class="font-mono text-chip whitespace-nowrap text-ink-faint max-[30rem]:hidden">
                  {sectionPosition
                    ? `Section ${String(sectionPosition).padStart(2, '0')} / ${String(navigationSections.length).padStart(2, '0')}`
                    : `${String(navigationSections.length).padStart(2, '0')} sections`}
                </span>
                <svg
                  class="disclosure-icon shrink-0 text-ink-faint transition-transform duration-[280ms] ease-[cubic-bezier(.22,1,.36,1)] group-open:rotate-45 motion-reduce:transition-none"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M12 5v14M5 12h14"></path>
                </svg>
              </summary>
              <div class="absolute right-0 top-[calc(100%_+_0.5rem)] z-50 w-[min(22rem,calc(100vw_-_2rem))] max-[48rem]:fixed max-[48rem]:top-16 max-[48rem]:right-4 max-[48rem]:left-4 max-[48rem]:w-auto disclosure-flow">
                <div class="disclosure-flow-inner">
                  <nav
                    class="nav-overlay-viewport w-full overflow-y-auto overscroll-contain border border-rule-strong bg-paper p-2"
                    aria-label="Book sections"
                  >
                    {navigationSections.map((section, index) => {
                      const isActive =
                        currentPath === section.href || currentPath.startsWith(`${section.href}`);
                      return (
                        <a
                          href={section.href}
                          class="group grid min-h-11 grid-cols-[2.25rem_minmax(0,1fr)] items-baseline gap-2 px-[0.65rem] py-[0.55rem] font-sans text-ui leading-[1.35] text-ink-muted no-underline transition-colors hover:bg-accent-soft hover:text-accent data-[active=true]:border-l data-[active=true]:border-accent data-[active=true]:bg-accent-soft data-[active=true]:text-accent"
                          aria-current={isActive ? 'location' : undefined}
                          data-active={isActive ? 'true' : 'false'}
                        >
                          <span class="font-mono text-chip tabular-nums text-ink-faint group-data-[active=true]:text-accent">
                            {String(index + 1).padStart(2, '0')}
                          </span>
                          <span>{section.title}</span>
                        </a>
                      );
                    })}
                  </nav>
                </div>
              </div>
            </details>
          ) : null}

          <button
            type="button"
            id="theme-toggle"
            class="inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center gap-1.5 rounded-ui border border-rule-strong bg-transparent px-2.5 py-1.5 font-sans text-ui font-medium leading-none text-ink transition-colors hover:border-accent hover:text-accent"
            aria-label="Switch to light theme"
          >
            <svg
              data-theme-icon="dark"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg
              data-theme-icon="light"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
            </svg>
            <span class="theme-label hidden sm:inline">Theme</span>
          </button>
        </div>
      </header>
    )}

    <slot />

    <div
      id="route-loader"
      data-route-loader
      transition:persist="route-loader"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      data-visible="false"
      class="pointer-events-none fixed inset-x-0 top-20 z-50 mx-auto w-shell opacity-0 transition-opacity duration-[180ms] data-[visible=true]:pointer-events-auto data-[visible=true]:opacity-100"
    >
      <span data-route-loader-message class="sr-only"></span>
      <div aria-hidden="true" class="space-y-3">
        <span class="block h-3 w-full animate-pulse rounded-ui bg-paper-raised motion-reduce:animate-none"></span>
        <span class="block h-3 w-11/12 animate-pulse rounded-ui bg-paper-raised motion-reduce:animate-none"></span>
        <span class="block h-3 w-8/12 animate-pulse rounded-ui bg-paper-raised motion-reduce:animate-none"></span>
      </div>
    </div>

    <script>
      import { createRouteLoaderController, wrapRouteLoader } from '../lib/route-loader.mjs';

      if (!Object.prototype.hasOwnProperty.call(document, 'routeLoaderInitialized')) {
        const controller = createRouteLoaderController({ document, window });
        document.addEventListener('astro:before-preparation', (event) => {
          controller.beforePreparation(event.signal);
          event.loader = wrapRouteLoader(
            event.loader,
            controller.cancel,
            () => event.defaultPrevented,
          );
        });
        document.addEventListener('astro:page-load', () => controller.pageLoad());
        Object.defineProperty(document, 'routeLoaderInitialized', { value: true });
      }
    </script>
    <script>
      import { bindThemeController } from '../lib/theme-controller.mjs';

      bindThemeController({ document });
    </script>
    <script>
      import { bindDisclosureController } from '../lib/disclosure-controller.mjs';

      bindDisclosureController({ document });
    </script>
  </body>
</html>
