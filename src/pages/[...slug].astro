---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReadingToc from '../components/ReadingToc.astro';
import PrevNext from '../components/PrevNext.astro';
import HomeTitleBlock from '../components/HomeTitleBlock.astro';

type Props = {
  entry: CollectionEntry<'notebook'>;
  prevEntry?: CollectionEntry<'notebook'>;
  nextEntry?: CollectionEntry<'notebook'>;
};

function toUrl(id: string): string {
  if (id === 'index') {
    return '/';
  }
  const clean = id.replace(/\.mdx?$/u, '').replace(/\/index$/u, '');
  return `/${clean}/`;
}

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replaceAll(/[^\w\s-]/gu, '')
    .trim()
    .replaceAll(/\s+/gu, '-');
}

export async function getStaticPaths() {
  const all = (await getCollection('notebook', ({ data }) => !data.draft)).toSorted(
    (a, b) => (a.data.order ?? 9999) - (b.data.order ?? 9999),
  );

  return all.map((entry, idx) => ({
    params: { slug: entry.id === 'index' ? undefined : entry.id },
    props: {
      entry,
      prevEntry: idx > 0 ? all[idx - 1] : undefined,
      nextEntry: idx < all.length - 1 ? all[idx + 1] : undefined,
    },
  }));
}

const { entry, prevEntry, nextEntry } = Astro.props;
const { Content, headings } = await render(entry);
const isHome = entry.id === 'index';

const parts = isHome
  ? []
  : entry.id
      .replace(/\.mdx?$/u, '')
      .replace(/\/index$/u, '')
      .split('/');

// Section index entries → nine numbered contributions (home).
// IDs may be `00-preface` or `00-preface/index` depending on loader.
const all = (await getCollection('notebook', ({ data }) => !data.draft)).toSorted(
  (a, b) => (a.data.order ?? 9999) - (b.data.order ?? 9999),
);
const contributions = all
  .filter((e) => {
    const id = e.id.replace(/\/index$/u, '');
    return id !== '' && id !== 'index' && !id.includes('/');
  })
  .map((e) => ({
    href: toUrl(e.id),
    title: e.data.title,
    description: e.data.description,
  }));

// Display-grade headings for TOC (h2/h3 only)
const tocHeadings = headings
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => ({
    id: h.slug || slugify(h.text),
    text: h.text,
    depth: h.depth,
  }));

const description = entry.data.description;
---

<BaseLayout title={entry.data.title} description={description}>
  {isHome ? (
    <>
      <HomeTitleBlock
        title={entry.data.title}
        description={
          description ??
          'Prove every speed win twice. A short book from 68 proven Oracle fixes, tools, and safe ship habits.'
        }
        contributions={contributions}
        meta={['68 catalog entries', 'grades', '37 pages · 9 sections', 'compiled 2026-09-22']}
        gradeZones={['a', 'a', 'b', 'b', 'c', 'c', 'd']}
        gradeLabels={['A1', 'A2', 'B1', 'B2', 'C1', 'C2', 'D']}
      />

      <main id="main" class="shell pb-20">
        <div class="prose-notebook measure pt-4">
          <Content />
        </div>
      </main>
    </>
  ) : (
    <>
      {/* Running head */}
      <div class="shell-wide pt-4 pb-2" aria-hidden="true">
        <div class="flex items-center justify-between gap-4 running-head">
          <span>Oracle SQL Optimization</span>
          <span class="truncate max-w-[50%] text-right">{entry.data.title}</span>
        </div>
      </div>

      <div class="shell-wide">
        <div class="grid lg:grid-cols-[280px_1fr] gap-6 lg:gap-12 items-start">
          {/* Margin apparatus — sticky section TOC (first on mobile for wayfinding) */}
          <div class="order-1 lg:sticky lg:top-16 min-w-0">
            {tocHeadings.length > 0 && <ReadingToc headings={tocHeadings} label="Sections" />}
          </div>

          {/* Reading column — centered in remaining track (preprint margin balance) */}
          <main id="main" class="order-2 min-w-0 pb-16 flex justify-center">
            <div class="w-full max-w-[46rem] min-w-0">
              {/* Breadcrumb */}
              <nav aria-label="Breadcrumb" class="mb-6">
                <ol class="flex flex-wrap items-center gap-x-1 gap-y-1 list-none p-0 m-0 meta">
                  <li>
                    <a href="/" class="hover:text-[color:var(--accent)] no-underline">
                      Home
                    </a>
                  </li>
                  {parts.map((part, i) => {
                    const url = `/${parts.slice(0, i + 1).join('/')}/`;
                    const isLast = i === parts.length - 1;
                    return (
                      <li class="flex items-center gap-1">
                        <span aria-hidden="true">/</span>
                        {isLast ? (
                          <span class="text-[color:var(--ink-muted)] normal-case tracking-normal font-[family-name:var(--font-serif)] text-sm">
                            {entry.data.title}
                          </span>
                        ) : (
                          <a href={url} class="hover:text-[color:var(--accent)] no-underline">
                            {part.replace(/^\d+-/u, '').replaceAll('-', ' ')}
                          </a>
                        )}
                      </li>
                    );
                  })}
                </ol>
              </nav>

              <article class="prose-notebook">
                <header class="mb-8 pb-6 border-b border-[color:var(--rule-strong)]">
                  <h1 class="m-0" style="font-size: var(--text-title); letter-spacing: -0.025em;">
                    {entry.data.title}
                  </h1>
                  {description && (
                    <p class="mt-3 mb-0 font-[family-name:var(--font-sans)] text-[color:var(--ink-muted)] text-[length:var(--text-ui)] leading-relaxed max-w-[55ch]">
                      {description}
                    </p>
                  )}
                </header>

                <Content />
              </article>

              <PrevNext
                prev={
                  prevEntry ? { href: toUrl(prevEntry.id), title: prevEntry.data.title } : undefined
                }
                next={
                  nextEntry ? { href: toUrl(nextEntry.id), title: nextEntry.data.title } : undefined
                }
              />

              <p class="mt-8 meta">
                <a href="/" class="hover:text-[color:var(--accent)] no-underline">
                  ← Book home
                </a>
              </p>
            </div>
          </main>
        </div>
      </div>
    </>
  )}

  <footer class="rule-top mt-auto">
    <div class="shell py-8 flex flex-wrap items-center justify-between gap-4">
      <p class="meta m-0">Oracle SQL Optimization · Evidence-graded notebook</p>
      <p class="meta m-0">Compiled 2026-09-22 · No live DB</p>
    </div>
  </footer>
</BaseLayout>
